<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="vertical">

    <ImageView
        android:id="@+id/ivEmptyStateInternal"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/nodata"
        android:layout_marginBottom="20dp"
        android:contentDescription="No Data" />

    <TextView
        android:id="@+id/tvEmptyTitleInternal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/empty_live_title"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="24dp" />

    <TextView
        android:id="@+id/tvEmptyStateInternal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/empty_live_desc"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:gravity="center"
        android:layout_marginHorizontal="32dp" />

</merge>
