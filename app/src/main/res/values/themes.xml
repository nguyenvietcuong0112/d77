<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/background</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_green_secondary</item>
        <item name="colorSecondaryVariant">@color/accent_green</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar and navigation bar customization for Dark Theme -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        
        <!-- Dark status and navigation bar to force light icons -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        
        <!-- Custom typography and colors -->
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:fontFamily">@font/sf_pro</item>
        <item name="fontFamily">@font/sf_pro</item>
    </style>
</resources>